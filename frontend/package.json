{
  "name": "groundline-frontend-draft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/lib/*.test.js worker/*.test.js",
    "build:static": "vite build --mode static",
    "deploy": "vite build && wrangler deploy",
    "deploy:static": "vite build --mode static && wrangler deploy --config wrangler.static.jsonc"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
